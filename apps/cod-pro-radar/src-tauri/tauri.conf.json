{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COD Pro Radar",
  "version": "0.1.0",
  "identifier": "app.codproradar.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "COD Pro Radar",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://static-cdn.jtvnw.net; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Twitch-Live-Radar für Call-of-Duty-Pros",
    "longDescription": "COD Pro Radar überwacht ausgewählte Twitch-Kanäle und zeigt an, welche Call-of-Duty-Pros live sind und ob sie vermutlich gerade Mitspieler suchen.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["de-DE"]
      }
    }
  }
}
